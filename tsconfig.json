{
	"compilerOptions": {
		/* --- ENVIRONMENT & LANGUAGE --- */
		"target": "esnext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["bun", "vite/client"],
		"allowJs": true,

		/* --- MODULES & RESOLUTION --- */
		"module": "preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["./src/*"],
			"@/public/*": ["./public/*"]
		},

		/* --- INTEROP & CONSTRAINTS --- */
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,

		/* --- EMIT / CODE GENERATION --- */
		"rootDir": ".",
		"outDir": "./dist",
		"noEmit": true,
		"incremental": true,
		"preserveConstEnums": true,

		/* --- TYPE CHECKING --- */
		"strict": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,

		// Relaxed vs. the backend tsconfig: exact-optional is a common source of
		// friction with third-party React prop types. Turn on per-project if you
		// want the stricter guarantee.
		"exactOptionalPropertyTypes": false,

		// Biome's correctness/noUnusedVariables + noUnusedFunctionParameters already
		// cover this — leave off here to avoid two tools disagreeing on the same file.
		"noUnusedLocals": false,
		"noUnusedParameters": false

		// "plugins": [
		// 	{
		// 		"name": "next"
		// 	}
		// ]
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.mts", "vite.config.ts"],
	"exclude": ["node_modules", "dist"]
}
