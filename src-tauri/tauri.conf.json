{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "ReelVault",
	"version": "0.1.0",
	"identifier": "org.reelvault.desktop",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:3000",
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"windows": [
			{
				"title": "ReelVault",
				"width": 1440,
				"height": 900,
				"resizable": true,
				"fullscreen": false,
				"minWidth": 1024,
				"minHeight": 700
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: http: https:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' http: https: ws: wss: ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
