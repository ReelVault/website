# Default backend API URL.
# When you open the app over the local network (e.g. reelvault.lan, 192.168.1.20, *.ts), the
# browser frontend automatically targets the same host on the backend port (3030).
VITE_REELVAULT_API_URL=http://localhost:3030

# URL used only by server.ts (the production /v1 + /api proxy for dist/).
# By default it connects directly to the local server:
REELVAULT_API_URL=http://127.0.0.1:3030
