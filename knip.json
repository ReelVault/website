{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"entry": ["src/routes/**", "tests/**/*.test.ts", "scripts/**/*.ts"],
	"project": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "tests/**/*.ts", "src/**/*.css"],
	"ignoreDependencies": ["@babel/preset-typescript"],
	"ignoreExportsUsedInFile": true,
	"rules": {
		"exports": "off",
		"types": "off",
		"duplicates": "off"
	}
}
