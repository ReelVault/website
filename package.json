{
	"name": "reelvault.website",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"**/*.scss"
	],
	"scripts": {
		"----RUN": "",
		"dev": "vite --force",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun run server.ts",
		"i18n": "bunx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
		"i18n:unused": "bun run scripts/find-unused-i18n.ts",
		"generate-routes": "bun run scripts/generate-routes.ts",
		"----DESKTOP": "",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build",
		"----CHECK": "",
		"format": "biome format --write && eslint --fix",
		"lint": "bun run lint:biome && bun run lint:oxlint",
		"lint:biome": "biome check --write",
		"lint:oxlint": "oxlint --type-aware",
		"deadcode": "knip-bun --config ./knip.json",
		"check-types": "bun run generate-routes && bun run i18n && tsc --noEmit --pretty",
		"test": "bun test",
		"----MISC": "",
		"tauri": "tauri",
		"prepare": "lefthook install",
		"doctor": "npx react-doctor@latest"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"@inlang/paraglide-js": "^2.25.4",
		"@inlang/paraglide-js-react": "^1.0.3",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.103.2",
		"@tanstack/react-router": "^1.170.39",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.4.0",
		"country-flag-icons": "^1.6.20",
		"embla-carousel-react": "^8.6.0",
		"hls.js": "^1.7.3",
		"lucide-react": "^1.47.0",
		"next-themes": "^0.4.6",
		"qrcode.react": "^4.2.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-intersection-observer": "^11.0.1",
		"@reelvault/sdk": "^1.0.1",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query-devtools": "^5.103.2",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-generator": "1.167.38",
		"@tanstack/router-plugin": "^1.168.40",
		"@tauri-apps/cli": "^2.11.5",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/parser": "^8.70.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.11.0",
		"knip": "^6.38.0",
		"lefthook": "^2.1.14",
		"oxc-transform-react": "^0.151.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2002",
		"react-scan": "^0.5.7",
		"shadcn": "^4.21.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.3.0",
		"vite-plugin-compression2": "^2.5.3"
	}
}
