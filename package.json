{
	"name": "reelvault.website",
	"version": "1.2.1",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"sideEffects": [
		"**/*.css",
		"**/*.scss"
	],
	"reelvault": {
		"minServerVersion": "1.2.1"
	},
	"scripts": {
		"----RUN": "",
		"dev": "vite --force",
		"build": "bun run generate-routes && bun run i18n && vite build",
		"preview": "vite preview",
		"start": "bun run server.ts",
		"i18n": "bunx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
		"i18n:unused": "bun run scripts/find-unused-i18n.ts",
		"generate-routes": "bun run scripts/generate-routes.ts",
		"----DESKTOP": "",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build",
		"----CHECK": "",
		"format": "biome format --write",
		"lint": "bun run lint:biome && bun run lint:oxlint",
		"lint:ci": "biome check && oxlint --type-aware",
		"lint:biome": "biome check --write",
		"lint:oxlint": "oxlint --type-aware",
		"deadcode": "knip-bun --config ./knip.json",
		"check-types": "bun run generate-routes && bun run i18n && tsc --noEmit --pretty",
		"test": "bun test",
		"----MISC": "",
		"tauri": "tauri",
		"prepare": "lefthook install",
		"doctor": "npx react-doctor@latest"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"@inlang/paraglide-js": "^2.26.0",
		"@inlang/paraglide-js-react": "^1.0.3",
		"@reelvault/sdk": "^1.2.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.4.0",
		"country-flag-icons": "^1.6.20",
		"embla-carousel-react": "^8.6.0",
		"hls.js": "^1.7.3",
		"lucide-react": "^1.52.0",
		"next-themes": "^0.4.6",
		"qrcode.react": "^4.2.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-intersection-observer": "^11.0.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"remark-github-blockquote-alert": "^2.1.0",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query-devtools": "^5.104.1",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-generator": "1.167.40",
		"@tanstack/router-plugin": "^1.168.42",
		"@tauri-apps/cli": "^2.12.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"knip": "^6.40.0",
		"lefthook": "^2.1.17",
		"oxc-transform-react": "^0.153.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"react-scan": "^0.5.7",
		"shadcn": "^4.21.3",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vite-plugin-compression2": "^2.5.3",
		"vite-plugin-pwa": "^2.0.0"
	}
}
