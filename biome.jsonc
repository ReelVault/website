{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!node_modules", "!.agents", "!dist", "!build", "!**/*.svg", "!**/routeTree.gen.ts", "!**/*.gen.ts", "!drizzle"]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedKeys": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 140,
		"lineEnding": "lf",
		"formatWithErrors": false
	},
	"javascript": {
		"globals": ["Bun"],
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"arrowParentheses": "always",
			"trailingCommas": "all",
			"semicolons": "always",
			"bracketSpacing": true
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "recommended",
			"react": "recommended",
			"next": "recommended",
			"test": "recommended",
			"drizzle": "recommended",
			"types": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useAltText": "error",
				"useKeyWithClickEvents": "error",
				"useButtonType": "error",
				"useMediaCaption": "warn",
				"useValidAriaProps": "error",
				"useValidAriaRole": "error",
				"noSvgWithoutTitle": "error"
			},
			"complexity": {
				"noUselessStringConcat": "error",
				"noUselessUndefinedInitialization": "error",
				"noVoid": "error",
				"useDateNow": "error",
				"noImportantStyles": "error",
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": { "maxAllowedComplexity": 35 }
				},
				"noExcessiveNestedTestSuites": "warn",
				"noForEach": "error",
				"useSimplifiedLogicExpression": "error",
				"noUselessTernary": "error",
				"noUselessTypeConstraint": "error",
				"noUselessSwitchCase": "error",
				"noUselessLoneBlockStatements": "error",
				"noUselessFragments": "error",
				"noAdjacentSpacesInRegex": "error"
			},
			"correctness": {
				"noConstantMathMinMaxClamp": "error",
				"noUndeclaredVariables": "error",
				"noUnusedImports": {
					"fix": "safe",
					"level": "error"
				},
				"noUnusedFunctionParameters": "error",
				"noUnusedPrivateClassMembers": "error",
				"useExhaustiveDependencies": {
					"level": "error",
					"options": {
						"reportUnnecessaryDependencies": false
					}
				},
				"noUnusedVariables": "error",
				"noUnreachable": "error",
				"noUnreachableSuper": "error",
				"noChildrenProp": "error",
				"noNestedComponentDefinitions": "error",
				"useIsNan": "error",
				"useValidTypeof": "error",
				"noInvalidConstructorSuper": "error",
				"noInvalidUseBeforeDeclaration": "error",
				"noSelfAssign": "error",
				"noSwitchDeclarations": "error",
				"noVoidTypeReturn": "error",
				"useHookAtTopLevel": "error",
				"useJsxKeyInIterable": "error",
				"noConstAssign": "error",
				"noPrecisionLoss": "error",
				"noSetterReturn": "error",
				"noGlobalObjectCalls": "error"
			},
			"security": {
				"noGlobalEval": "error",
				"noBlankTarget": "error",
				"noDangerouslySetInnerHtml": "error",
				"noDangerouslySetInnerHtmlWithChildren": "error"
			},
			"performance": {
				"noAccumulatingSpread": "error",
				"noBarrelFile": "warn",
				"noReExportAll": "warn",
				"noNamespaceImport": "warn",
				"useTopLevelRegex": "error",
				"noDelete": "error",
				// Next.js-only guidance (next/image). This app is a Vite SPA with no image optimizer.
				"noImgElement": "off"
			},
			"style": {
				"noParameterProperties": "error",
				"noYodaExpression": "error",
				"useConsistentBuiltinInstantiation": "error",
				"useFragmentSyntax": "error",
				"useShorthandAssign": "error",
				"useArrayLiterals": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				},
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"useThrowOnlyError": "error",
				"useThrowNewError": "error",
				"useNodejsImportProtocol": "error",
				"useImportType": "error",
				"useExportType": "error",
				"useConsistentTypeDefinitions": {
					"level": "error",
					"options": { "style": "interface" }
				},
				// Page modules are consumed through React.lazy and lazyRouteComponent, which take default exports.
				"noDefaultExport": "off",
				// Layout sizes and timeouts stay inline where they are used; a named constant per value would hide them.
				"noMagicNumbers": "off",
				// API payloads and plugin schema keys keep the server wire casing; one convention would rename them at the boundary.
				"useNamingConvention": "off",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"useConst": "error",
				"useDefaultSwitchClause": "warn",
				"useNumberNamespace": "error",
				"useTemplate": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error",
				"useExplicitLengthCheck": "error",
				"useDefaultParameterLast": "error",
				"noRestrictedTypes": {
					"level": "error",
					"options": {
						"types": {
							"object": "Use a specific interface or 'Record<string, unknown>' instead.",
							"Function": "Use a specific function signature instead."
						}
					}
				}
			},
			"suspicious": {
				"useAwait": "error",
				"noEvolvingTypes": "error",
				"noDeprecatedImports": "error",
				// Enforced by oxlint typescript/no-explicit-any (error); each rule has one source.
				"noExplicitAny": "off",
				"noConsole": {
					"level": "warn",
					"options": { "allow": ["warn", "error"] }
				},
				"noConstantBinaryExpressions": "error",
				"noDoubleEquals": "error",
				"noConfusingVoidType": "error",
				"noReactForwardRef": "error",
				"noDuplicatedSpreadProps": "error",
				"noUnknownAttribute": "error",
				"noArrayIndexKey": "warn",
				"noAssignInExpressions": "error",
				"noAsyncPromiseExecutor": "error",
				"noCatchAssign": "error",
				"noCommentText": "error",
				"noCompareNegZero": "error",
				"noControlCharactersInRegex": "error",
				"noDebugger": "error",
				"noDuplicateCase": "error",
				"noDuplicateClassMembers": "error",
				"noDuplicateObjectKeys": "error",
				"noDuplicateParameters": "error",
				"noEmptyBlockStatements": "warn",
				"noFallthroughSwitchClause": "error",
				"noFunctionAssign": "error",
				"noGlobalAssign": "error",
				"noImportAssign": "error",
				"noLabelVar": "error",
				"noMisleadingCharacterClass": "error",
				"noMisleadingInstantiator": "error",
				"noPrototypeBuiltins": "error",
				"noSelfCompare": "error",
				"noShadowRestrictedNames": "error",
				"noSparseArray": "error",
				"noThenProperty": "error",
				"noUnsafeDeclarationMerging": "error",
				"noUnsafeNegation": "error",
				"useAdjacentOverloadSignatures": "error",
				"useErrorMessage": "error",
				"useGetterReturn": "error",
				"useNamespaceKeyword": "error",
				"useNumberToFixedDigitsArgument": "error",
				"noVar": "error",
				"noWith": "error",
				"noOctalEscape": "error"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"attributes": ["class", "className"],
						"functions": ["clsx", "cva", "cn", "tw"]
					}
				},
				// Type-aware rules run once, in oxlint, which has the type information: no-floating-promises, no-misused-promises,
				// await-thenable, no-unsafe-type-assertion, no-unsafe-plus-operands and no-base-to-string.
				"noFloatingPromises": "off",
				"noMisusedPromises": "off",
				"useAwaitThenable": "off",
				"noUnsafeTypeAssertion": "off",
				"noUselessTypeConversion": "error",
				"noUnnecessaryTemplateExpression": "error",
				"noUnsafePlusOperands": "off",
				"noBaseToString": "off",
				"noMisleadingReturnType": "error",
				"noImpliedEval": "error",
				"noExtendNative": "error",
				"noLoopFunc": "error",
				"noUnmodifiedLoopCondition": "error",
				"useExhaustiveSwitchCases": "error",
				"useArraySome": "error",
				"useIncludes": "error",
				"noDrizzleDeleteWithoutWhere": "error",
				"noDrizzleUpdateWithoutWhere": "error",
				"noThisOutsideOfClass": "error",
				"noJsxLeakedDollar": "error",
				"noReactStringRefs": "error",
				"noNegationInEqualityCheck": "error",
				"noEmptyObjectKeys": "error",
				"noExcessiveNestedCallbacks": "warn"
			}
		}
	},
	"overrides": [
		{
			// TanStack file routes encode params and layouts in file names ($id.tsx, _web.tsx) and use a leading "-" for
			// colocated helpers (-auth-guard.ts); kebab-case cannot express them.
			"includes": ["src/routes/**"],
			"linter": { "rules": { "style": { "useFilenamingConvention": "off" } } }
		},
		{
			// CLI tools in scripts/ report their results on stdout; console output is their interface.
			"includes": ["scripts/**"],
			"linter": { "rules": { "suspicious": { "noConsole": "off" } } }
		},
		{
			// The prefers-reduced-motion resets must beat animation timings set elsewhere, which only !important can do.
			"includes": ["src/styles/globals.css", "src/styles/simple-animation.css"],
			"linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
		},
		{
			// The single module allowed to write document.cookie. The write is synchronous by design (see its header).
			"includes": ["src/lib/document-cookie.ts"],
			"linter": { "rules": { "suspicious": { "noDocumentCookie": "off" } } }
		},
		{
			// Shadcn Label: callers pass htmlFor or nest a control, but the props spread hides both from the rule.
			"includes": ["src/components/ui/label.tsx"],
			"linter": { "rules": { "a11y": { "noLabelWithoutControl": "off" } } }
		},
		{
			// The addon forwards pointer clicks to its input (keyboard users focus the input), and role="group" is the
			// correct ARIA role for this non-form container.
			"includes": ["src/components/ui/input-group.tsx"],
			"linter": { "rules": { "a11y": { "useKeyWithClickEvents": "off", "useSemanticElements": "off" } } }
		},
		{
			// The player container and the controls overlay take pointer events on purpose (controls show/hide, auto-hide).
			"includes": ["src/pages/player/app-player.tsx", "src/pages/player/components/player-chrome.tsx"],
			"linter": { "rules": { "a11y": { "noStaticElementInteractions": "off" } } }
		},
		{
			// These lists are positional and never reorder: slider thumbs keep their identity by index, and the PIN slots
			// are decorative. The schema renderer's lists are static per plugin surface, and each key includes the node type.
			"includes": [
				"src/components/ui/slider.tsx",
				"src/pages/auth/profiles/components/pin-verification.modal.tsx",
				"src/plugin-host/schema/renderer.tsx"
			],
			"linter": { "rules": { "suspicious": { "noArrayIndexKey": "off" } } }
		}
	]
}
